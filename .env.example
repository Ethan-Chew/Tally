# Postgres database that holds the Maybe schema (restore your pg_dump into it, see README)
DATABASE_URL=postgres://localhost:5432/maybe_production
PORT=3001

# Backups (all optional). Defaults shown.
# BACKUP_DIR=~/Documents/maybe-lite-backups     where `npm run db:backup` writes
# BACKUP_MIRROR_DIR=/Volumes/External/backups   a second copy (external drive, iCloud/Dropbox folder, NAS)
# BACKUP_KEEP=14                                how many untagged backups to keep in each folder
