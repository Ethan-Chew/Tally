{
  "name": "tally",
  "private": true,
  "license": "MIT",
  "repository": "github:Ethan-Chew/Tally",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "db:local:init": "bash scripts/db/local-db.sh init",
    "db:local:start": "bash scripts/db/local-db.sh start",
    "db:local:stop": "bash scripts/db/local-db.sh stop",
    "db:local:status": "bash scripts/db/local-db.sh status",
    "db:import": "bash scripts/db/import.sh",
    "db:backup": "bash scripts/db/backup.sh",
    "db:backups": "bash scripts/db/list.sh",
    "db:restore": "bash scripts/db/restore.sh",
    "db:backup:schedule": "bash scripts/db/schedule-backup.sh"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
